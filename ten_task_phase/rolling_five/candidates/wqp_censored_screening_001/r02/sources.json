  "scope_and_decision_path": {
    "natural_scope": "The publicly identified river station immediately below Leadville; all returned cadmium dates, not a handpicked time interval. All rows identify SWMN.",
    "first_result": "137 rows; default chooses only Lower Reporting Limit, omits result IDs. 28 dissolved non-detects and 30 J-R records required qualifier-aware interpretation.",
    "next_state": "narrowResult supplies 137 unique ResultIdentifiers; complete result-limit profile returns 246 records of two types, joined by exact identity.",
    "hardness": "102 station hardness records; unique exact organization/activity match for every dissolved result. Seven withdrawn. All remaining records report the WQX-approved Hardness, Ca, Mg characteristic in mg/L, whose CaCO3 basis is defined by EPA SRS E1640416. Method 200.7(W) is not grounds for rejecting that basis.",
    "shortest_observed_path": "A complete narrow-result + full-limit + same-station-hardness package with qualifier dictionaries and criterion/method documentation is legal. No saved single result profile itself contains the sample classifications. Bulk retrieval is not counted as difficulty.",
    "new_judgment": "Default LRL is not the DL qualifier censoring threshold; J-R is a complete code, not J plus R; its declared interval can cross a threshold despite a point estimate. The remaining U/CRQL mismatch is retained as unresolved rather than invented.",
    "no_prediction": "No low-score prediction or ability score; no blind test.",
    "minimal_public_output": "Nonempty evidence/hardness/screen category counts; all 101 per-result decisions retained privately. No change in scope or public format from r01."
  },
  "source_interpretation": {
    "qualifiers": "d0006.csv exact current DL/J-R/U/QC/SCP entries, with d0008.csv legacy comparison. J-R describes a reporting-limit/MDL interval; U expressly refers to adjusted CRQL, absent among returned limit types.",
    "cadmium_criterion": "web_15.json EPA current table explicitly refers to 2001 chronic criterion after vacatur. web_5.json and web_9.json official 2001 report; exp(0.7409 lnH -4.719)*(1.101672-0.041838 lnH). Screen is equation arithmetic, not duration/frequency compliance.",
    "hardness_basis": "EPA SRS E1640416 indexed official record: exact WQX-approved Hardness, Ca, Mg synonym maps to total hardness, defined in CaCO3-equivalent mg/L. controller_srs_indexed.json preserves the acquired indexed text; controller_srs_open.json is only a JavaScript shell. No direct rendered-page or NEMI4690 success is claimed. Unknown in the synonym table is its quality rating, not a statement that the concentration basis is unknown.",
    "profile_warning": "d0009.response EPA WQX detection guidance, especially table3 hierarchy and table5 DL definition. Raw PDF downloaded successfully.",
    "limits_of_inference": "All intervals describe reported analytical evidence, not guaranteed true concentration ranges or confidence intervals; no legal/temporal compliance or ecosystem protection statement."
  },
  "independent_review_status": "r01 audit blocked only B1; r02 repair pending independent targeted review"
